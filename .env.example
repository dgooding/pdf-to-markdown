# Local / hosted environment configuration
# Copy this to .env and fill in values — NEVER commit .env

# Network binding
PORT=8000
HOST=127.0.0.1

# Publish secret — set a strong random value when hosting publicly
# Leave empty to allow unrestricted publishing (local development only)
PUBLISH_SECRET=

# Persistent published-document directory
# On Render this is set to the mounted disk path automatically via render.yaml
DATA_ROOT=

# Conversion limits
MAX_UPLOAD_MB=50
STALE_JOB_SECONDS=3600
